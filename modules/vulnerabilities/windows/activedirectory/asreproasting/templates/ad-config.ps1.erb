$logFile = 'C:\ad-config-log.txt'

# If already completed, clean up and exit
if (Test-Path C:\ad-config-complete.txt) {
    Unregister-ScheduledTask -TaskName 'ADConfig' -Confirm:$false -ErrorAction SilentlyContinue
    Unregister-ScheduledTask -TaskName 'DCPromotionReboot' -Confirm:$false -ErrorAction SilentlyContinue
    exit 0
}

# Mark that reboot has occurred
'rebooted' | Out-File C:\forest-reboot-marker.txt -Force
"$(Get-Date) - AD config starting" | Out-File $logFile -Force

# Wait for Active Directory Web Services to become available
$maxWait = 600
$elapsed = 0
while ($elapsed -lt $maxWait) {
    try {
        Import-Module ActiveDirectory -ErrorAction Stop
        Get-ADDomain -ErrorAction Stop
        "$(Get-Date) - ADWS ready after $elapsed seconds" | Out-File $logFile -Append
        break
    } catch {
        Start-Sleep -Seconds 10
        $elapsed += 10
    }
}
if ($elapsed -ge $maxWait) {
    "$(Get-Date) - TIMEOUT waiting for AD after $maxWait seconds" | Out-File C:\ad-config-error.txt
    exit 1
}

# ---------------------------------------------------------------
# Create asrep_user1 — primary AS-REP roastable target
# This account has pre-authentication disabled, making it
# vulnerable. An attacker can request its AS-REP hash without
# supplying a password and crack it offline.
# ---------------------------------------------------------------
try {
    if (-not (Get-ADUser -Filter {SamAccountName -eq 'asrep_user1'} -ErrorAction SilentlyContinue)) {
        New-ADUser `
            -Name 'asrep_user1' `
            -SamAccountName 'asrep_user1' `
            -AccountPassword (ConvertTo-SecureString '<%= @user_password %>' -AsPlainText -Force) `
            -Enabled $true `
            -PasswordNeverExpires $true `
            -ErrorAction Stop
        "$(Get-Date) - Created asrep_user1" | Out-File $logFile -Append
    }
} catch {
    "$(Get-Date) - Error creating asrep_user1: $_" | Out-File C:\ad-config-error.txt -Append
}

# Disable Kerberos pre-authentication — this is the vulnerability.
# UAC flag UF_DONT_REQUIRE_PREAUTH (0x400000) is set via
# Set-ADAccountControl. Without pre-auth, the KDC returns an
# AS-REP encrypted with the user's password hash, which can
# be cracked offline with hashcat/john.
try {
    Set-ADAccountControl -Identity 'asrep_user1' -DoesNotRequirePreAuth $true -ErrorAction Stop
    "$(Get-Date) - Disabled Kerberos pre-auth for asrep_user1" | Out-File $logFile -Append
} catch {
    "$(Get-Date) - Error disabling pre-auth for asrep_user1: $_" | Out-File C:\ad-config-error.txt -Append
}

try {
    if (-not (Get-ADUser -Filter {SamAccountName -eq 'asrep_svc'} -ErrorAction SilentlyContinue)) {
        New-ADUser `
            -Name 'asrep_svc' `
            -SamAccountName 'asrep_svc' `
            -AccountPassword (ConvertTo-SecureString '<%= @svc_password %>' -AsPlainText -Force) `
            -Enabled $true `
            -PasswordNeverExpires $true `
            -ErrorAction Stop
        "$(Get-Date) - Created asrep_svc" | Out-File $logFile -Append
    }
} catch {
    "$(Get-Date) - Error creating asrep_svc: $_" | Out-File C:\ad-config-error.txt -Append
}

try {
    Set-ADAccountControl -Identity 'asrep_svc' -DoesNotRequirePreAuth $true -ErrorAction Stop
    "$(Get-Date) - Disabled Kerberos pre-auth for asrep_svc" | Out-File $logFile -Append
} catch {
    "$(Get-Date) - Error disabling pre-auth for asrep_svc: $_" | Out-File C:\ad-config-error.txt -Append
}


try {
    if (-not (Get-ADUser -Filter {SamAccountName -eq 'student1'} -ErrorAction SilentlyContinue)) {
        New-ADUser `
            -Name 'student1' `
            -SamAccountName 'student1' `
            -AccountPassword (ConvertTo-SecureString '<%= @student_password %>' -AsPlainText -Force) `
            -Enabled $true `
            -ErrorAction Stop
        "$(Get-Date) - Created student1" | Out-File $logFile -Append
    }
} catch {
    "$(Get-Date) - Error creating student1: $_" | Out-File C:\ad-config-error.txt -Append
}

Set-ADUser -Identity 'asrep_user1' -Description '<%= @asrep_user1_flag %>'
Set-ADUser -Identity 'asrep_svc'   -Description '<%= @asrep_svc_flag %>'

# Mark complete and clean up scheduled tasks
"$(Get-Date) - AD configuration complete" | Out-File $logFile -Append
'AD configuration complete' | Out-File C:\ad-config-complete.txt
Unregister-ScheduledTask -TaskName 'ADConfig' -Confirm:$false -ErrorAction SilentlyContinue
Unregister-ScheduledTask -TaskName 'DCPromotionReboot' -Confirm:$false -ErrorAction SilentlyContinue